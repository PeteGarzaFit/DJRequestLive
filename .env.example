# Copy to .env (Hostinger: set these in the Node.js app's environment variables instead)
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_request
DB_PASSWORD=change-me
DB_NAME=u123456789_request

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Spotify Web API app credentials (server-side only; never expose in Vite variables)
